# 이 파일을 .env.local 로 복사한 뒤 값을 채운다.
# .env.local 은 .gitignore 에 있어서 저장소에 올라가지 않는다.
#
# Vercel 에 배포할 때는 Settings > Environment Variables 에 같은 값을 넣는다.

# Supabase — Settings > API 에서 복사한다.
# anon 키는 페이지 소스에 그대로 드러나는 공개 키다. 비밀 키(service_role)가
# 아니다. 쓰기 권한은 이 키가 아니라 DB 의 RLS 정책이 정한다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 사이트 주소. 링크 미리보기 · sitemap · canonical 주소의 기준이 된다.
# 안 넣으면 Vercel 배포 주소를 쓴다. 검색엔진에 등록할 거라면 넣어야 한다.
# 비어 있으면 알려준 주소와 실제 주소가 달라져 색인이 꼬인다.
NEXT_PUBLIC_SITE_URL=

# 댓글(giscus). 값이 lib/site.ts 에 이미 있어서 평소에는 비워둬도 된다.
# 저장소를 옮길 때만 https://giscus.app 에서 새 값을 받아 채운다.
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
